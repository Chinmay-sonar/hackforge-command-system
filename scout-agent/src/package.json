{
  "name": "scout-agent",
  "version": "0.1.0",
  "type": "module",
  "description": "Scout: the HackForge agent that scrapes a hackathon website and extracts structured info (theme, rules, judging criteria, deadlines, submission requirements, required tech/APIs) using the Gemini API.",
  "main": "src/cli.js",
  "bin": {
    "scout": "src/cli.js"
  },
  "scripts": {
    "scout": "node src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "hackathon",
    "agent",
    "gemini",
    "scraper"
  ],
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.9.0",
    "axios": "^1.18.0",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "cli-table3": "^0.6.5",
    "dotenv": "^17.4.2",
    "groq-sdk": "^1.3.0",
    "pdf-parse": "^1.1.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "puppeteer": "^24.43.1"
  },
  "author": ""
}
