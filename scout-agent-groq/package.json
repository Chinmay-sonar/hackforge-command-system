{
  "name": "scout-agent",
  "version": "0.2.0",
  "type": "module",
  "description": "Scout: scrapes a hackathon website and extracts structured info (theme, rules, judging criteria, deadlines, submission requirements, required tech/APIs) using Groq.",
  "main": "src/cli.js",
  "bin": {
    "scout": "src/cli.js"
  },
  "scripts": {
    "scout": "node src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["hackathon", "agent", "groq", "scraper"],
  "license": "ISC",
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "groq-sdk": "^1.3.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "puppeteer": "^24.0.0"
  }
}
